# Settings of meshcom-status, as environment variables, with their default values.
#
# Copy this file to `.env` in this folder (never committed) and change what differs for your
# installation:
#
#   cd docker && cp env.example .env
#
# Docker Compose reads `.env` next to `compose.yml`: it fills the `${...}` in `compose.yml` and
# passes every variable below to the server. Outside Compose, export them in the shell, or use the
# command-line options or the TOML file instead (`meshcom-status --help` describes each one).

# --- Database (used by the `postgres` service and by the server's URL in compose.yml) ---------

POSTGRES_USER=meshcom
POSTGRES_PASSWORD=meshcom
POSTGRES_DB=meshcom

# --- Docker Compose --------------------------------------------------------------------------

# Host port of the web page and the API.
MESHCOM_STATUS_HTTP_PORT=8080

# --- meshcom-status --------------------------------------------------------------------------

# Configuration file; a missing file is not an error.
MESHCOM_STATUS_CONFIG=meshcom-status.toml

# Log level: error, warn, info, debug or trace.
MESHCOM_STATUS_LOG_LEVEL=info

# Address and port the web server listens on (inside the container).
MESHCOM_STATUS_WEB_LISTEN_ADDRESS=0.0.0.0:8080

# Path prefix of the API, e.g. to serve behind a reverse proxy under another path.
MESHCOM_STATUS_WEB_API_PREFIX=/api

# Base maps offered by the page: a JSON array of {"name", "url", "attribution", "max_zoom"}.
MESHCOM_STATUS_WEB_BASE_MAPS='[{"name":"OpenStreetMap","url":"https://tile.openstreetmap.org/{z}/{x}/{y}.png","attribution":"© OpenStreetMap contributors","max_zoom":19},{"name":"OpenTopoMap","url":"https://tile.opentopomap.org/{z}/{x}/{y}.png","attribution":"Map data © OpenStreetMap contributors, SRTM · Style © OpenTopoMap (CC-BY-SA)","max_zoom":17},{"name":"Esri World Imagery","url":"https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}","attribution":"Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community","max_zoom":19}]'

# The MeshCom node: host name or IP address. The program's default is unset (no node is
# contacted); this is an example address, replace it with your node's.
MESHCOM_STATUS_NODE_HOST=192.0.2.10

# Node HTTP port (own callsign and position).
MESHCOM_STATUS_NODE_HTTP_PORT=80

# Node net console (frames with signal reports; the node needs "--netconsole on" and
# "--loradebug on").
MESHCOM_STATUS_NODE_CONSOLE_ENABLED=true
MESHCOM_STATUS_NODE_CONSOLE_PORT=2323

# Node KISS over TCP (off by default: with the net console it would count each frame twice).
MESHCOM_STATUS_NODE_KISS_ENABLED=false
MESHCOM_STATUS_NODE_KISS_PORT=8001

# PostgreSQL. In compose.yml the server's URL is built from the POSTGRES_* values above and the
# `postgres` service, whatever this line says; it applies when running outside Compose.
MESHCOM_STATUS_DATABASE_URL=postgres://meshcom:meshcom@localhost:5432/meshcom
